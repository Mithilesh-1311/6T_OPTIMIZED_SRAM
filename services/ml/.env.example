# Set in shell/Render environment; Python does not implicitly load this file.
# SAMS_DEPLOYMENT=production
# ML_SERVICE_TOKEN=<same random 32+ character secret as Node; server-only>
# SAMS_EVIDENCE_URL=<private HTTPS download URL for accepted export archive; build-time>
# SAMS_EVIDENCE_SHA256=<archive SHA256; build-time>
# RENDER_EXTERNAL_HOSTNAME is supplied by Render. Local defaults need no settings.
